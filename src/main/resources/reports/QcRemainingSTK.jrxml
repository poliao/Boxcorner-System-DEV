<jasperReport name="Blank_A4_Landscape" language="java" columnCount="3" printOrder="Horizontal" pageWidth="595" pageHeight="842" orientation="Landscape" columnWidth="179" leftMargin="28" rightMargin="28" topMargin="28" bottomMargin="28" uuid="92fb443f-f328-49b1-a048-d611226b3a51">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
