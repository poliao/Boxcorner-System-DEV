	<property name="com.jaspersoft.studio.unit.topMargin" value="mm"/>
	<parameter name="jobId" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[-- expand qc_remaining_destroy_staff: 1 row ต่อ 1 ห่อ ของแต่ละคน (เฉพาะ STK ไม่มีเศษซับซ้อน)
WITH staff_packs AS (
    SELECT
        s.qc_remaining_destroy_id                                AS remaining_id,
        s.id                                                     AS staff_id,
        s.user_name                                              AS user_name,
        gs                                                       AS pack_seq,
        FALSE                                                    AS is_fraction
    FROM qc_remaining_destroy_staff s
    JOIN LATERAL generate_series(1, COALESCE(s.packs, 0)) AS gs ON TRUE
    WHERE COALESCE(s.packs, 0) > 0

    UNION ALL

    SELECT
        s.qc_remaining_destroy_id                                AS remaining_id,
        s.id                                                     AS staff_id,
        s.user_name                                              AS user_name,
        COALESCE(s.packs, 0) + 1                                 AS pack_seq,
        TRUE                                                     AS is_fraction
    FROM qc_remaining_destroy_staff s
    WHERE COALESCE(s.packs_fraction, 0) > 0
)
SELECT
    j.jo_id                                                      AS joid,
    j.job_name                                                   AS jobname,
    j.part_name                                                  AS partname,
    sp.user_name                                                 AS qcname,
    CASE WHEN sp.is_fraction THEN COALESCE(stf.bundles_fraction, 0) ELSE r.bundles_per_pack END
                                                                 AS bundlesperpack,
    r.boxes_per_bundle                                           AS boxesperpundle,
    CASE
        WHEN sp.is_fraction THEN
            (COALESCE(stf.bundles_fraction, 0) * COALESCE(r.boxes_per_bundle, 0))
            + COALESCE(stf.pieces_fraction, 0)
        ELSE
            COALESCE(r.bundles_per_pack, 0) * COALESCE(r.boxes_per_bundle, 0)
    END                                                          AS totalboxesperpack,
    r.created_at                                                 AS dateend
FROM staff_packs sp
INNER JOIN qc_remaining_destroy r ON r.id = sp.remaining_id
INNER JOIN qc_jobs j ON j.id = r.qc_job_id
INNER JOIN qc_remaining_destroy_staff stf ON stf.id = sp.staff_id
WHERE r.qc_job_id = $P{jobId}
ORDER BY sp.remaining_id, sp.staff_id, sp.pack_seq;]]></query>
