qc_finish_date as dateEnd,
bundles_fraction as bundlesFraction,
pieces_fraction as piecesFraction,
job_name as jobName,
part_name as partName,
pack_no as packNo
FROM get_qc_labels($P{jobId}, $P{logId});]]></query>
