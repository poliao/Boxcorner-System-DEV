	<title height="210">
			<element kind="textField" x="0" y="0" width="400" height="30" fontName="THSarabun" fontSize="22.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA["แบบบันทึกการลา"]]></expression>
			</element>
			<element kind="textField" x="400" y="0" width="155" height="18" fontName="THSarabun" fontSize="12.0" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA["เลขที่เอกสาร: HR FM-01"]]></expression>
			</element>
			<element kind="textField" x="400" y="18" width="155" height="18" fontName="THSarabun" fontSize="12.0" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA["แก้ไขครั้งที่ (Rev.): 02"]]></expression>
			</element>
			<element kind="textField" x="0" y="32" width="555" height="22" fontName="THSarabun" fontSize="15.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA["ประจำปี พ.ศ. " + $P{pYearBE}]]></expression>
			</element>
			<element kind="textField" x="0" y="62" width="280" height="20" fontName="THSarabun" fontSize="14.0" vTextAlign="Middle">
				<expression><![CDATA["รหัสพนักงาน: " + ($P{pCode} == null ? "-" : $P{pCode})]]></expression>
			</element>
			<element kind="textField" x="280" y="62" width="275" height="20" fontName="THSarabun" fontSize="14.0" vTextAlign="Middle">
				<expression><![CDATA["ชื่อ-นามสกุล: " + ($P{pName} == null ? "-" : $P{pName})]]></expression>
			</element>
			<element kind="textField" x="0" y="84" width="280" height="20" fontName="THSarabun" fontSize="14.0" vTextAlign="Middle">
				<expression><![CDATA["ตำแหน่ง: " + ($P{pPosition} == null ? "-" : $P{pPosition})]]></expression>
			</element>
			<element kind="textField" x="280" y="84" width="275" height="20" fontName="THSarabun" fontSize="14.0" vTextAlign="Middle">
				<expression><![CDATA["แผนก: " + ($P{pDepartment} == null ? "....................." : $P{pDepartment})]]></expression>
			</element>
			<element kind="textField" x="0" y="112" width="555" height="20" fontName="THSarabun" fontSize="14.0" bold="true" vTextAlign="Middle">
				<expression><![CDATA["สิทธิวันลา (1 วัน = 8 ชั่วโมง)"]]></expression>
				<box><pen lineWidth="0.5"/></box>
			</element>
			<element kind="textField" x="0" y="132" width="555" height="18" fontName="THSarabun" fontSize="13.0" vTextAlign="Middle">
				<expression><![CDATA[$P{pVacCarryLine}]]></expression>
				<box><leftPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
			</element>
			<element kind="textField" x="0" y="150" width="555" height="18" fontName="THSarabun" fontSize="13.0" vTextAlign="Middle">
				<expression><![CDATA[$P{pVacLine}]]></expression>
				<box><leftPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
			</element>
			<element kind="textField" x="0" y="168" width="555" height="18" fontName="THSarabun" fontSize="13.0" vTextAlign="Middle">
				<expression><![CDATA[$P{pPerLine}]]></expression>
				<box><leftPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
			</element>
			<element kind="textField" x="0" y="186" width="555" height="18" fontName="THSarabun" fontSize="13.0" vTextAlign="Middle">
				<expression><![CDATA[$P{pSickLine}]]></expression>
				<box><leftPen lineWidth="0.5"/><rightPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/></box>
			</element>
	</title>
	<columnHeader height="40">
			<element kind="textField" x="0" y="0" width="555" height="14" fontName="THSarabun" fontSize="13.0" bold="true" vTextAlign="Middle">
				<expression><![CDATA["รายการลา"]]></expression>
			</element>
			<element kind="textField" x="0" y="14" width="25" height="26" fontName="THSarabun" fontSize="11.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["ลำดับ"]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="25" y="14" width="140" height="26" fontName="THSarabun" fontSize="11.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["เหตุผลการลา"]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="165" y="14" width="65" height="26" fontName="THSarabun" fontSize="11.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["ลาจากวันที่"]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="230" y="14" width="65" height="26" fontName="THSarabun" fontSize="11.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["ถึงวันที่"]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="295" y="14" width="55" height="26" fontName="THSarabun" fontSize="11.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["ช่วงเวลา"]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="350" y="14" width="45" height="26" fontName="THSarabun" fontSize="10.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["ลาป่วย (ชม.)"]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="395" y="14" width="50" height="26" fontName="THSarabun" fontSize="10.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["ลาพักร้อน (ชม.)"]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="445" y="14" width="45" height="26" fontName="THSarabun" fontSize="10.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["ลากิจ (ชม.)"]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="490" y="14" width="65" height="26" fontName="THSarabun" fontSize="11.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA["ผู้อนุมัติ"]]></expression><box><pen lineWidth="0.5"/></box></element>
	</columnHeader>
	<detail>
		<band height="22">
			<element kind="textField" x="0" y="0" width="25" height="22" fontName="THSarabun" fontSize="11.0" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{seq}]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="25" y="0" width="140" height="22" fontName="THSarabun" fontSize="11.0" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{reason}]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="165" y="0" width="65" height="22" fontName="THSarabun" fontSize="10.0" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{dateFrom}]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="230" y="0" width="65" height="22" fontName="THSarabun" fontSize="10.0" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{dateTo}]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="295" y="0" width="55" height="22" fontName="THSarabun" fontSize="10.0" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{timeRange}]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="350" y="0" width="45" height="22" fontName="THSarabun" fontSize="11.0" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{sickHours}]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="395" y="0" width="50" height="22" fontName="THSarabun" fontSize="11.0" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{vacationHours}]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="445" y="0" width="45" height="22" fontName="THSarabun" fontSize="11.0" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{personalHours}]]></expression><box><pen lineWidth="0.5"/></box></element>
			<element kind="textField" x="490" y="0" width="65" height="22" fontName="THSarabun" fontSize="10.0" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{approver}]]></expression><box><pen lineWidth="0.5"/></box></element>
		</band>
	</detail>
	<summary height="250">
			<element kind="textField" x="0" y="6" width="555" height="20" fontName="THSarabun" fontSize="13.0" bold="true" vTextAlign="Middle">
				<expression><![CDATA[$P{pTotalLine}]]></expression>
				<box><pen lineWidth="0.5"/></box>
			</element>
			<element kind="textField" x="0" y="34" width="555" height="18" fontName="THSarabun" fontSize="13.0" bold="true" vTextAlign="Middle">
				<expression><![CDATA["ระเบียบการลา"]]></expression>
			</element>
			<element kind="textField" x="0" y="52" width="555" height="16" fontName="THSarabun" fontSize="11.0"><expression><![CDATA["1. พนักงานที่ประสงค์ลางาน ต้องแจ้งล่วงหน้าก่อนวันลา ยกเว้นกรณีฉุกเฉินหรือเจ็บป่วยกระทันหัน"]]></expression></element>
			<element kind="textField" x="0" y="68" width="555" height="16" fontName="THSarabun" fontSize="11.0"><expression><![CDATA["2. การลาป่วยตั้งแต่ 3 วันทำงานติดต่อกันขึ้นไป ต้องแนบใบรับรองแพทย์ประกอบการลา"]]></expression></element>
			<element kind="textField" x="0" y="84" width="555" height="16" fontName="THSarabun" fontSize="11.0"><expression><![CDATA["3. การลากิจส่วนตัว กรุณาแจ้งล่วงหน้าอย่างน้อย 1 วันทำการ และขึ้นอยู่กับการอนุมัติของหัวหน้างาน"]]></expression></element>
			<element kind="textField" x="0" y="100" width="555" height="16" fontName="THSarabun" fontSize="11.0"><expression><![CDATA["4. สิทธิการลากิจไม่หักเงินค่าจ้าง กำหนดไม่เกิน 3 วันต่อปี (ตามเงื่อนไขบริษัท)"]]></expression></element>
			<element kind="textField" x="0" y="116" width="555" height="16" fontName="THSarabun" fontSize="11.0"><expression><![CDATA["5. บริษัทขอสงวนสิทธิ์ในการพิจารณาการลา กรณีมีผลกระทบต่อการปฏิบัติงานหรือการผลิต"]]></expression></element>
			<element kind="textField" x="0" y="132" width="555" height="16" fontName="THSarabun" fontSize="11.0"><expression><![CDATA["6. พนักงานต้องกรอกข้อมูลการลาให้ครบถ้วน และส่งเอกสารให้ HR ภายในระยะเวลาที่กำหนด"]]></expression></element>
			<element kind="textField" x="0" y="186" width="185" height="18" fontName="THSarabun" fontSize="12.0" hTextAlign="Center"><expression><![CDATA["ลงชื่อ ............................"]]></expression></element>
			<element kind="textField" x="185" y="186" width="185" height="18" fontName="THSarabun" fontSize="12.0" hTextAlign="Center"><expression><![CDATA["ลงชื่อ ............................"]]></expression></element>
			<element kind="textField" x="370" y="186" width="185" height="18" fontName="THSarabun" fontSize="12.0" hTextAlign="Center"><expression><![CDATA["ลงชื่อ ............................"]]></expression></element>
			<element kind="textField" x="0" y="204" width="185" height="18" fontName="THSarabun" fontSize="12.0" hTextAlign="Center"><expression><![CDATA["พนักงาน"]]></expression></element>
			<element kind="textField" x="185" y="204" width="185" height="18" fontName="THSarabun" fontSize="12.0" hTextAlign="Center"><expression><![CDATA["หัวหน้างาน"]]></expression></element>
			<element kind="textField" x="370" y="204" width="185" height="18" fontName="THSarabun" fontSize="12.0" hTextAlign="Center"><expression><![CDATA["ผู้จัดการ"]]></expression></element>
	</summary>
</jasperReport>
