<!-- Leave Record (HR FM-01) - JasperReports 7.0.3 compact JRXML, bean datasource -->
<jasperReport name="LeaveRecordReport" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<parameter name="pYearBE" class="java.lang.String"/>
	<parameter name="pCode" class="java.lang.String"/>
	<parameter name="pName" class="java.lang.String"/>
	<parameter name="pPosition" class="java.lang.String"/>
